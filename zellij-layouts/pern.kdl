layout {
    tab name="pern-dev" {
        pane split_direction="vertical" {
            pane name="vscode" command="code" {
                args "."
            }
            pane split_direction="horizontal" {
                pane name="opencode" command="opencode"
                pane name="terminal" command="bash"
            }
        }
    }
    tab name="db" {
        pane name="postgres" command="docker" {
            args "compose" "up" "postgres"
        }
    }
    tab name="hermes" {
        pane name="hermes" command="hermes"
    }
}
