layout {
    tab name="astro-dev" {
        pane split_direction="vertical" {
            pane name="vscode" command="code" {
                args "."
            }
            pane split_direction="horizontal" {
                pane name="opencode" command="opencode" {
                    args "-m" "ollama/llama2-uncensored" "."
                }
                pane name="terminal" command="bash"
            }
        }
    }
    tab name="wp" {
        pane name="wp-server" command="bash"
    }
    tab name="hermes" {
        pane name="hermes" command="hermes"
    }
}